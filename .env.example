# Copie este arquivo como .env. Nunca envie .env ao GitHub.
# O endereço da API InfiniteGear já está preenchido.
INFINITEGEAR_API_URL=https://api.crm.infinitegear.app
# Gere um token permanente em Ajustes > Integrações > Integração via API.
# Cole somente o token (sem a palavra Bearer).
INFINITEGEAR_API_TOKEN=

# Opcional: usado apenas nas operações que requerem autenticação de parceiro.
# Gere em Admin > Personalizar > Integração, se você administra um parceiro.
INFINITEGEAR_PARTNER_TOKEN=

# Comece com false. true permite criar, editar, excluir e enviar mensagens.
INFINITEGEAR_ALLOW_WRITES=false

# Apenas modo HTTP/VPS: senha própria deste MCP, diferente do token do CRM.
# Gere no terminal: openssl rand -hex 32
INFINITEGEAR_MCP_TOKEN=

# Opcional: origem HTTPS pública deste MCP quando há um proxy reverso.
# Exemplo de formato: https://mcp.seudominio.com (use seu domínio real).
INFINITEGEAR_PUBLIC_URL=
